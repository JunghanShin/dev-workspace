#!/bin/bash
# network.conf를 읽어 고정 IP를 적용한다
# (workspace-start.sh가 시작할 때마다 root로 실행).
# 설정 파일은 실행하지 않고 KEY=VALUE로만 읽는다.
set -euo pipefail

CONF="${1:?usage: workspace-network-apply <network.conf>}"
declare -A cfg=()

while IFS= read -r line || [[ -n "$line" ]]; do
  line="${line%%#*}"
  [[ "$line" =~ ^[[:space:]]*([A-Z_]+)=(.*)$ ]] || continue
  value="${BASH_REMATCH[2]}"
  value="${value%"${value##*[![:space:]]}"}"
  value="${value#\"}"; value="${value%\"}"
  cfg[${BASH_REMATCH[1]}]="$value"
done < "$CONF"

# ---- 고정 IP -----------------------------------------------------------------
if [[ "${cfg[ENABLED]:-no}" != yes ]]; then
  echo "$CONF: ENABLED=${cfg[ENABLED]:-no}, network unchanged"
  exit 0
fi

iface="${cfg[IFACE]:-}"
read -r -a addrs <<< "${cfg[ADDRESSES]:-}"
gateway="${cfg[GATEWAY]:-}"
read -r -a dns <<< "${cfg[DNS]:-}"

ipv4='([0-9]{1,3}\.){3}[0-9]{1,3}'
[[ -n "$iface" ]] || { echo "IFACE is required" >&2; exit 1; }
ip link show "$iface" >/dev/null 2>&1 || { echo "interface $iface not found" >&2; exit 1; }
(( ${#addrs[@]} > 0 )) || { echo "ADDRESSES is required" >&2; exit 1; }
for a in "${addrs[@]}"; do
  [[ "$a" =~ ^$ipv4/[0-9]{1,2}$ ]] || { echo "bad address: $a" >&2; exit 1; }
done
[[ -z "$gateway" || "$gateway" =~ ^$ipv4$ ]] || { echo "bad gateway: $gateway" >&2; exit 1; }
for d in "${dns[@]}"; do
  [[ "$d" =~ ^$ipv4$ ]] || { echo "bad dns: $d" >&2; exit 1; }
done

if ! systemctl is-active --quiet NetworkManager || ! command -v nmcli >/dev/null; then
  echo "NetworkManager is not active; this board expects NetworkManager" >&2
  exit 1
fi

con="workspace-$iface"
joined="$(IFS=,; echo "${addrs[*]}")"
if ! nmcli -t -f NAME connection show | grep -qx "$con"; then
  nmcli connection add type ethernet ifname "$iface" con-name "$con" \
    ipv4.method manual ipv4.addresses "$joined"
fi
nmcli connection modify "$con" \
  ipv4.method manual \
  ipv4.addresses "$joined" \
  ipv4.gateway "$gateway" \
  ipv4.dns "$(IFS=,; echo "${dns[*]}")" \
  connection.autoconnect yes \
  connection.autoconnect-priority 100
nmcli connection up "$con"
echo "applied $con: $joined gw=${gateway:-none} dns=${dns[*]:-none}"
