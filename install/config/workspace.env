# 워크스페이스 실행 설정. workspace-start.sh가 시작할 때 읽는다(KEY=VALUE, 실행하지 않음).
# 경로(소켓·설정·기록 위치)는 넣지 않는다. 데이터 폴더 기준으로 workspace-start.sh가 정한다.
# 바꾼 뒤: ./workspace-start.sh(실행 중이면 멈추고 다시 시작)

## REST 어댑터
# REST·화면이 받는 주소. 0.0.0.0 = 모든 망, 127.0.0.1 = 보드 안에서만(SSH 터널로 열 때)
WORKSPACE_REST_BIND=0.0.0.0
# REST·화면 포트(화면 주소 http://<보드>:<포트>)
WORKSPACE_REST_PORT=8080
# 워커 명령 응답을 기다리는 시간(초). 장치 응답을 기다리는 명령(장치 ACK 등)보다 길게
WORKSPACE_REST_COMMAND_TIMEOUT=3

## 화면
# 보드에서 제공하는 화면(http://<Jetson>:8080)의 영상 주소 틀. 기본은 이 보드의 MediaMTX WebRTC.
# {host} = 브라우저가 접속한 이 보드 주소, {path} = 워커 송출 경로. 원격 미디어 서버를 보려면 예: http://<원격 미디어 서버>:8889/{path}
#WORKSPACE_UI_MEDIA_URL=http://{host}:8889/{path}

# 화면 제목(왼쪽 위, 브라우저 탭). 프로젝트 이름은 프로필에 둔다
#WORKSPACE_UI_TITLE=Workspace

## 로그
# 워크스페이스 서비스 로그 수준(DEBUG, INFO, WARNING, ERROR)
WORKSPACE_LOG_LEVEL=INFO

## 기록 workspace-logger (design.md 6.9)
# 지표 기록 간격(초)
WORKSPACE_LOGGER_INTERVAL_S=1
# 기록 파일 하나의 최대 크기(MB). 넘으면 새 파일
WORKSPACE_LOGGER_MAX_FILE_MB=64
# 기록 전체 최대 크기(MB). 넘으면 오래된 파일부터 지움
WORKSPACE_LOGGER_MAX_TOTAL_MB=2048

## 접근 (제품 모드에서 주로 씀, design.md 11.4)
# REST 접근 토큰. 비어 있으면 인증 없음(개발). 제품 설치(install.sh)가 장비별로 만든다. 화면은 처음에 물어 쿠키에 둔다
# WORKSPACE_REST_TOKEN=
# C++ 게이트웨이 신분 확인(on/off, 기본 off). on이면 로그인·사용자별 토큰·역할(<데이터>/config/users.json, gateway user add). 제품 모드는 늘 on
# WORKSPACE_AUTH=off
# 보드가 화면을 내줄지(1/0). 0이면 화면 없이 REST만(별도 제어 UI가 REST로 통신)
# WORKSPACE_UI=1
