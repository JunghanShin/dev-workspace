{
  "payload-manager": {
    "exec": ["@WORKSPACE_ROOT@/managers/payload/bin/payload-manager"],
    "exec_candidates": [
      "@WORKSPACE_ROOT@/managers/payload/build/payload-manager",
      "@WORKSPACE_ROOT@/managers/payload/build/jetson/install/bin/payload-manager",
      "@WORKSPACE_ROOT@/managers/payload/bin/payload-manager"
    ],
    "kind": "manager",
    "module_control": true,
    "start_timeout_sec": 10,
    "watchdog_sec": 5,
    "stop_timeout_sec": 3,
    "builtin": {"id": "payload-manager", "autostart": true, "config": {}}
  }
}
