{
  "name": "config",
  "version": "1.0",
  "description": "소프트웨어 버전과 설정 스냅숏(managers/config/design.md 2·3·4장). config-manager가 낸다",
  "topics": {
    "config": {
      "description": "버전 목록·어긋남·스냅숏 목록·drift(마지막 스냅숏 뒤로 바뀜). 바뀌면 바로, 그대로면 10 s",
      "type": "object",
      "required": ["t_mono_ns", "versions", "libworker", "mismatch", "snapshots", "drift"],
      "properties": {
        "t_mono_ns": {"type": "integer", "unit": "ns"},
        "versions": {"type": "object"}, "libworker": {"type": "object"}, "mismatch": {"type": "array"},
        "profile": {"type": ["object", "null"]}, "snapshots": {"type": "array"}, "drift": {"type": "boolean"}
      }
    }
  },
  "commands": {
    "config.versions": {"description": "버전 목록", "read": true, "args": {"type": "object"}, "reply": {"type": "object", "additionalProperties": true}, "errors": []},
    "config.snapshots": {"description": "남긴 스냅숏 목록", "read": true, "args": {"type": "object"}, "reply": {"type": "object", "additionalProperties": true}, "errors": ["busy"]},
    "config.diff": {"description": "그 스냅숏과 지금의 다른 점", "read": true,
                    "args": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string"}}},
                    "reply": {"type": "object", "additionalProperties": true}, "errors": ["bad_request", "unavailable", "busy"]},
    "config.snapshot": {"description": "지금 것을 남김(바꾸는 것 없음)", "operate": true,
                        "args": {"type": "object", "properties": {"label": {"type": "string"}}},
                        "reply": {"type": "object", "additionalProperties": true}, "errors": ["unavailable", "internal", "busy"]},
    "config.restore": {"description": "워커 설정·연결 선언을 스냅숏대로(개발 모드에서만: process-manager가 검사). 워크스페이스 설정 파일은 되돌리지 않음",
                       "args": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string"}, "workers": {"type": "array", "items": {"type": "string"}}}},
                       "reply": {"type": "object", "additionalProperties": true}, "errors": ["bad_request", "busy"]}
  }
}
